# Copy to .env. scripts/configure.py generates local secrets instead of defaults.
ENVIRONMENT=development
DEMO_MODE=true
JWT_SECRET=
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=
POSTGRES_USER=sportpredict
POSTGRES_PASSWORD=
POSTGRES_DB=sportpredict
# Native development; Compose overrides DATABASE_URL and REDIS_URL internally.
DATABASE_URL=sqlite:///./sportpredict.db
REDIS_URL=redis://localhost:6379/0
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SECURE=false
TOKEN_MINUTES=60
ARTIFACT_DIR=artifacts
FIXTURE_PROVIDER=demo
FIXTURE_API_URL=
FIXTURE_API_TOKEN=
# Native API-Football: FIXTURE_PROVIDER=api_football and DEMO_MODE=false.
API_FOOTBALL_KEY=
API_FOOTBALL_DAYS_AHEAD=1
API_FOOTBALL_MAX_REQUESTS=20
API_FOOTBALL_DAILY_BUDGET=90
API_FOOTBALL_FIXTURE_CACHE_MINUTES=60
API_FOOTBALL_ODDS_CACHE_MINUTES=180
PIPELINE_INTERVAL_MINUTES=15
# Canonical gateway league IDs; domestic top flights, configurable, not a ranking.
ENABLED_LEAGUES=premier-league,la-liga,bundesliga,serie-a,ligue-1,eredivisie,primeira-liga,belgian-pro-league,super-lig,scottish-premiership
# Optional sports-skills public feeds: personal/research only, never production.
SPORTS_SKILLS_PERSONAL_USE=false
SPORTS_SKILLS_COMPETITIONS=premier-league
SPORTS_SKILLS_DAYS_AHEAD=3
SPORTS_SKILLS_HISTORY=false
SPORTS_SKILLS_ENRICH_LIMIT=4
# SDK replay is off unless explicitly configured; never publish replay captures.
SPORTS_SKILLS_REPLAY=off
SPORTS_SKILLS_REPLAY_DIR=
BOOKING_PROVIDER=unavailable
BOOKING_API_URL=
BOOKING_API_TOKEN=
API_INTERNAL_URL=http://127.0.0.1:8000
MLFLOW_TRACKING_URI=
SENTRY_DSN=
ALERT_WEBHOOK_URL=
